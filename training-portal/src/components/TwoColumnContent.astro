---
/* Starlight's TwoColumnContent (0.43) with a way to hide the right sidebar ("On this page").
   Wide illustrations and diagrams get the space back. The choice is kept per browser in localStorage
   (key tp-toc-hidden) and applied before paint by the inline script in astro.config.mjs `head`, which sets
   html[data-toc-hidden]. Only applies at Starlight's two-column width (72rem and up). */
import { Icon } from '@astrojs/starlight/components';
---

<div class="lg:sl-flex">
	{
		Astro.locals.starlightRoute.toc && (
			<aside class="right-sidebar-container print:hidden">
				<div class="right-sidebar">
					<button type="button" class="tp-toc-toggle tp-toc-hide" data-tp-toc="hide" aria-label="Hide On this page" title="Hide On this page">
						<Icon name="right-caret" size="1rem" />
						<span>Hide</span>
					</button>
					<slot name="right-sidebar" />
				</div>
			</aside>
		)
	}
	<div class="main-pane"><slot /></div>
	{
		Astro.locals.starlightRoute.toc && (
			<button type="button" class="tp-toc-toggle tp-toc-show print:hidden" data-tp-toc="show" aria-label="Show On this page" title="Show On this page">
				<Icon name="left-caret" size="1rem" />
				<span>On this page</span>
			</button>
		)
	}
</div>

<script>
	const set = (hidden: boolean) => {
		document.documentElement.toggleAttribute('data-toc-hidden', hidden);
		try {
			if (hidden) localStorage.setItem('tp-toc-hidden', '1');
			else localStorage.removeItem('tp-toc-hidden');
		} catch {}
	};
	document.querySelectorAll<HTMLButtonElement>('[data-tp-toc]').forEach((button) =>
		button.addEventListener('click', () => {
			const hide = button.dataset.tpToc === 'hide';
			set(hide);
			document.querySelector<HTMLButtonElement>(`[data-tp-toc="${hide ? 'show' : 'hide'}"]`)?.focus();
		})
	);
</script>

<style>
	@layer starlight.core {
		.main-pane {
			isolation: isolate;
		}

		@media (min-width: 72rem) {
			.right-sidebar-container {
				order: 2;
				position: relative;
				/* Keep the sidebar at the end of the row if it paints before the main pane is parsed. */
				margin-inline-start: auto;
				width: max(
					var(--sl-sidebar-width),
					calc(
						var(--sl-sidebar-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2
					)
				);
			}

			.right-sidebar {
				position: fixed;
				top: 0;
				border-inline-start: 1px solid var(--sl-color-hairline);
				padding-top: var(--sl-nav-height);
				width: 100%;
				height: 100vh;
				overflow-y: auto;
				scrollbar-width: none;
			}

			.main-pane {
				width: 100%;
			}

			:global([data-has-sidebar][data-has-toc]) .main-pane {
				--sl-content-margin-inline: auto 0;

				order: 1;
				width: min(
					calc(100% - var(--sl-sidebar-width)),
					calc(
						var(--sl-content-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2
					)
				);
			}
		}
	}

	/* The hide / show buttons (outside the Starlight layer so they win over its resets) */
	.tp-toc-toggle {
		display: none;
		align-items: center;
		gap: 0.25rem;
		padding: 0.25rem 0.6rem 0.25rem 0.45rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
		line-height: 1.4;
		cursor: pointer;
	}
	.tp-toc-toggle:hover,
	.tp-toc-toggle:focus-visible {
		color: var(--sl-color-white);
		border-color: var(--sl-color-gray-3);
	}

	@media (min-width: 72rem) {
		/* Fixed to the window: .right-sidebar is itself fixed at width 100%, so it runs past the window edge */
		.tp-toc-hide {
			display: inline-flex;
			position: fixed;
			top: calc(var(--sl-nav-height) + 1rem);
			inset-inline-end: 1rem;
			z-index: 2;
		}
		.tp-toc-show {
			position: fixed;
			top: calc(var(--sl-nav-height) + 1rem);
			inset-inline-end: 1rem;
			z-index: 2;
		}

		/* Hidden: drop the right column, let the page use the width, and offer the show button */
		:global(html[data-toc-hidden]) .right-sidebar-container {
			display: none;
		}
		:global(html[data-toc-hidden]) .tp-toc-show {
			display: inline-flex;
		}
		:global(html[data-toc-hidden][data-has-sidebar][data-has-toc]) .main-pane {
			width: 100%;
			--sl-content-margin-inline: auto;
		}
	}
</style>
